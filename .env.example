# ==========================================
# WeatherSense AI — Environment Variables
# ==========================================

# Port for local full-stack dev server (default: 3000)
PORT=3000

# GEMINI_API_KEY: Required for live Google Gemini AI weather analysis & chat.
# In Google AI Studio, this is automatically injected at runtime from Secrets.
# For local VS Code development, get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# OPENWEATHER_API_KEY: Optional. For live OpenWeather One Call / Current API.
# If omitted, WeatherSense AI seamlessly queries Open-Meteo live API, or runs in Demo Mode.
# Get a key at: https://openweathermap.org/api
OPENWEATHER_API_KEY="YOUR_OPENWEATHER_API_KEY_HERE"

# MONGODB_URI: Optional. For persistent storage of IoT sensor readings & weather history.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/weathersense
MONGODB_URI="mongodb://localhost:27017/weathersense"

# VITE_API_BASE_URL: Optional override if running frontend and backend on separate ports.
# Defaults to relative '/api' which works out-of-the-box in full-stack server mode.
VITE_API_BASE_URL="/api"
